rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================================
       WHO IS ASKING
       ===================================================================== */
    function signedIn() { return request.auth != null; }
    function em() { return request.auth.token.email; }
    function owner() { return signedIn() && em() == 'allen@ascentpartnersltd.com'; }

    /* =====================================================================
       THE PRODUCTION POOLS ARE NEVER READ BY A GUEST.
       That is the whole design, and it is why this file carries no migration.
       A guest reads a SHOWROOM, which is a copy holding no real addresses, so
       the production rule below, read only if your email is in members, already
       denies them with no change at all.
       Named explicitly rather than inferred, so that a `showroom` flag written
       onto a production pool by accident still grants nobody anything.
       ===================================================================== */
    function prodPool(poolId) {
      return poolId == 'col-du-fantasy' || poolId == 'vuelta-2026';
    }

    /* =====================================================================
       LEGACY SINGLE-POOL COLLECTIONS
       config/roster holds `players` and `reviewers`, BOTH KEYED BY EMAIL. A
       blanket signedIn() read there hands every player's address to anyone who
       can sign in, which now includes invited guests. It is a leak path entirely
       separate from pool membership, and nothing about the showroom design
       closes it, so it is closed here.
       isMember() is the right gate and needs no guest predicate: a guest is in
       neither `players` nor `reviewers`, so they are denied by the same test
       that admits a player.
       ===================================================================== */
    function hasRoster() { return exists(/databases/$(database)/documents/config/roster); }
    function roster()    { return get(/databases/$(database)/documents/config/roster).data; }
    function isPlayer()   { return signedIn() && hasRoster() && (em() in roster().players); }
    function isReviewer() { return signedIn() && hasRoster() && (em() in roster().reviewers); }
    function isMember()   { return owner() || isPlayer() || isReviewer(); }

    match /config/{doc} {
      allow read:  if isMember();
      allow write: if owner();
    }
    match /drafts/{stage} {
      allow read:  if isMember();
      allow write: if isPlayer() || owner();
    }
    match /engagement/{doc} {
      allow read:           if isMember();
      /* was signedIn(): a guest could create their own document here. A viewer
         writes nothing anywhere, so the gate matches the drafts rule above. */
      allow create, update: if (isPlayer() || owner()) && doc == em();
      allow delete:         if owner();
    }
    match /race/{doc=**} {
      /* was signedIn(). Legacy single-pool race data; no guest path reads it. */
      allow read:  if isMember();
      allow write: if owner();
    }

    /* =====================================================================
       POOLS
       The production block is UNCHANGED from what is deployed today. The only
       addition anywhere is viewerOf(), and it can never be true on a production
       pool because prodPool() denies it by name.
       ===================================================================== */
    function poolCfg(poolId)    { return get(/databases/$(database)/documents/pools/$(poolId)).data; }
    function poolExists(poolId) { return exists(/databases/$(database)/documents/pools/$(poolId)); }
    function inPool(poolId)     { return signedIn() && poolExists(poolId) && (em() in poolCfg(poolId).members); }
    function poolMember(poolId) { return owner() || inPool(poolId); }
    function poolSeat(poolId)    { return poolCfg(poolId).members[em()]; }
    function predsLocked(poolId) { return poolCfg(poolId).predictionsLocked == true; }

    /* =====================================================================
       A DEMO POOL, where a guest PLAYS one seat.
       Designed in PHASE2-DEMO.md, deliberately left out of the shipped ruleset
       until 2026-11-19, and NARROWED on the way in: that design also granted
       predictions and the predictionsLocked flip, and this grants neither. The
       brief is "may write that pool's drafts for their own seat only, and
       nothing else anywhere", so drafts are the only thing that moved.

       A DEMO SEAT COMES FROM `viewerSeats` AND NEVER FROM `members`, and that is
       the whole point rather than a detail. `inPool()` reads `members`, so every
       member-gated statement in this file stays dead for a guest, and the guest
       never appears in a map that is email to seat on a pool anyone plays for
       real. Adding them to `members` would have been one line and would have
       handed them a draft write on whatever else that map is read for.

       THE `('demo' in ...)` GUARD IS NOT DECORATION. Without it, a pool carrying
       no `demo` field makes this an EVALUATION ERROR rather than a false. It
       denies either way, and that is exactly the problem: an error that happens
       to deny is not the same claim as a rule that denies, and the next error at
       this line would be indistinguishable from this one. The same guard is on
       showroomPool() one block up, for the same reason.

       BOTH FLAGS ARE REQUIRED. viewerOf() already demands `showroom == true`, so
       a demo pool carries `showroom: true` AND `demo: true`. PHASE2-DEMO.md put
       the choice this way round on purpose: carrying both flags is a smaller
       change than widening showroomPool() to accept either, and it keeps ONE
       read path for who may read a copy. */
    function isDemoPool(poolId) {
      return !prodPool(poolId) && poolExists(poolId)
        && ('demo' in poolCfg(poolId)) && poolCfg(poolId).demo == true;
    }
    function hasDemoSeat(poolId) {
      return isDemoPool(poolId)
        && ('viewerSeats' in poolCfg(poolId)) && (em() in poolCfg(poolId).viewerSeats);
    }
    function demoSeat(poolId) { return poolCfg(poolId).viewerSeats[em()]; }

    /* WHAT A DEMO GUEST MAY WRITE TO A DRAFT, and it is two shapes and no others.

       PHASE2-DEMO.md accepted an unscoped draft write, because all four seats
       live in one `picks` array and a rule cannot cheaply scope that. The brief
       asks for the seat scoping anyway, and it turns out to be cheap in the one
       direction that matters: a DRAFT ONLY EVER GROWS BY ONE PICK, so the rule
       can read the pick that was just appended and insist it carries the
       caller's own seat.

         1. APPEND ONE PICK, and it must be theirs. The new list is exactly one
            longer and the element at the old length names demoSeat().
         2. RESET. A list of one pick or none, which is the Reset demo button
            putting stage 18 back to its opening state. It is not scoped to a
            seat because the opening pick belongs to AA, and a guest who could
            not write it could not reset the board they are playing on.

       Everything else is refused: rewriting a pick in place, deleting one from
       the middle, appending two at once, or appending one that names another
       seat. The emulator suite asserts each of those rather than assuming them.

       THE GUARDS ARE EXPLICIT because `resource` is null on a CREATE and
       `picks` can be absent on either side, and both of those would be an
       evaluation error here. A demo draft is seeded by the build, so a guest
       creating one is not a case anyone needs; refusing it is the safe half. */
    function demoDraftShapeOk(poolId) {
      return ('picks' in request.resource.data)
        && resource != null && ('picks' in resource.data)
        && (
          (request.resource.data.picks.size() == resource.data.picks.size() + 1
            && request.resource.data.picks[resource.data.picks.size()].player == demoSeat(poolId))
          || request.resource.data.picks.size() <= 1
        );
    }

    /* A VIEWER is named in the showroom pool's `viewers` map, email to an EXPIRY
       TIMESTAMP, which is the same shape `members` already has. Three conditions,
       all required:
         - the pool is not one of the two production pools, by name
         - the pool document declares itself a showroom
         - the caller is named in viewers AND that date has not passed
       Expiry is enforced HERE rather than by a cleanup job, so a lapsed invitation
       stops working on its own and revoking one early is a single map key. */
    function showroomPool(poolId) {
      /* Same guard as viewerOf: a pool with no `showroom` field makes this an
         evaluation error rather than a false. Both deny; only one of them is a claim. */
      return !prodPool(poolId) && poolExists(poolId)
        && ('showroom' in poolCfg(poolId)) && poolCfg(poolId).showroom == true;
    }
    function viewerOf(poolId) {
      return signedIn()
        && showroomPool(poolId)
        /* Each term is GUARDED so that bad data DENIES as a rule rather than erroring.
           An absent `viewers`, or an expiry written as a string by a hand-edit, makes
           the comparison an evaluation error: it denies either way, but an error that
           happens to deny is not the same claim as a rule that denies, and the next
           error at this line would be indistinguishable from this one. */
        && ('viewers' in poolCfg(poolId))
        && (em() in poolCfg(poolId).viewers)
        && poolCfg(poolId).viewers[em()] is timestamp
        && request.time < poolCfg(poolId).viewers[em()];
    }
    function poolReader(poolId) { return poolMember(poolId) || viewerOf(poolId); }

    match /pools/{poolId} {
      allow read:  if owner() || (signedIn() && em() in resource.data.members) || viewerOf(poolId);
      allow write: if owner();

      /* Two scoped member updates, unchanged. Multiple `allow update` statements
         are ORed, which is why these sit alongside `allow write: if owner()`
         without either weakening the other. A VIEWER satisfies neither, because
         viewerOf() is not inPool(). */
      allow update: if inPool(poolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['predictionsLocked'])
        && request.resource.data.predictionsLocked == true
        && exists(/databases/$(database)/documents/pools/$(poolId)/predictions/JJ)
        && exists(/databases/$(database)/documents/pools/$(poolId)/predictions/JB)
        && exists(/databases/$(database)/documents/pools/$(poolId)/predictions/JP)
        && exists(/databases/$(database)/documents/pools/$(poolId)/predictions/AA);
      allow update: if inPool(poolId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personaLedger'])
        && request.resource.data.personaLedger.keys().hasOnly(['order','by','seen'])
        && request.resource.data.personaLedger.order is list
        && request.resource.data.personaLedger.by is map
        && request.resource.data.personaLedger.seen is map;

      match /drafts/{stage} {
        allow read:  if poolReader(poolId);
        allow write: if poolMember(poolId);
        /* THE ONE WRITE A GUEST EVER GETS, and it is this line. It is a separate
           statement rather than a widening of the one above, because multiple
           allow-write statements are ORed: the member grant keeps working
           exactly as it does, and nothing is added to a production pool or to a
           showroom, neither of which carries `demo: true`.

           Firestore stops at the first granting statement, so the order of these
           two is a performance detail and not a security one. It is written
           second because that is where PHASE2-DEMO.md put it. */
        allow write: if viewerOf(poolId) && hasDemoSeat(poolId) && demoDraftShapeOk(poolId);
      }
      match /stages/{stage} {
        allow read:  if poolReader(poolId);
        allow write: if owner();
      }
      match /engagement/{doc} {
        allow read:           if poolMember(poolId);
        allow create, update: if inPool(poolId) && doc == em();
        allow delete:         if owner();
      }
      /* A viewer sees the jersey predictions ONLY once they are locked, which on a
         finished-season showroom they always are. A blank panel where a completed
         side game should be is the locked-screen failure this exists to avoid. */
      match /predictions/{seat} {
        allow read:  if (poolMember(poolId) && (poolSeat(poolId) == seat || predsLocked(poolId)))
                     || (viewerOf(poolId) && predsLocked(poolId));
        allow write: if inPool(poolId) && poolSeat(poolId) == seat && !predsLocked(poolId);
        /* THE OWNER MAY SEED A SHOWROOM'S PREDICTIONS, and nowhere else. A showroom is
           a COPY, and the copy tool scrubs every address out of `members`, which is the
           whole reason a guest is safe on it; that same scrub is what leaves nobody able
           to write these documents, because the clause above grants on a seat held
           through `members`. So the predictions matrix arrived empty on a board whose
           locked matrix is one of the things a guest is meant to see.

           showroomPool() carries BOTH halves of the guard: not a production pool by
           NAME, and the pool document declares `showroom: true`. Either alone is not
           enough, which is the property the emulator suite stages deliberately by
           writing a showroom flag onto the production pools and asserting a refusal.

           It is an `allow write` of its own rather than a widening of the clause above,
           because multiple allow-write statements are ORed: the seat rule keeps working
           exactly as it does today and this adds nothing to a production pool. The
           owner still cannot write predictions on col-du-fantasy or vuelta-2026, where
           they hold no seat, and that is asserted rather than assumed. */
        allow write: if owner() && showroomPool(poolId);
      }
    }

    match /userPools/{uid} {
      /* A viewer READS their own so the switcher can move between the two showroom
         boards, and WRITES only their own, which is what it has always been.
         THIS WAS TIGHTENED TO isMember() AND REVERTED, because it locked people out.
         isMember() is the LEGACY config/roster, and every board writes this document
         on sign-in to keep the switcher and the not-a-member reroute working. A pool
         member who is not in that roster, which is every Lowry City Rollers member and
         anyone added to a pool since, would have had the write denied. The board
         swallows it with catch(), so nothing would error: the entry would simply stop
         being maintained, and a member whose entry was never written would land on
         "You are not in a pool yet."
         IT BOUGHT NOTHING. A guest writing their own userPools grants themselves no
         access: every read is still checked against members or viewers, and
         resolvePool skips an id it cannot open. The list is a hint for the switcher,
         never a permission. */
      allow read:  if signedIn() && (uid == em() || owner());
      allow write: if owner() || (signedIn() && uid == em());
    }

    /* =====================================================================
       GUEST PASSES AND THE VISIT LOG
       Added 2026-11-18, when a guest stopped signing in with an emailed code and
       started arriving on a personal LINK.

       OWNER ONLY, BOTH, READ AND WRITE. Not "owner plus the guest it is about",
       and the distinction is the point:

       - guestPasses/{passId} is a CREDENTIAL TABLE. The document id IS the secret
         in somebody's link, and the collection is a list of every live link and
         every synthetic address. One signed-in reader who should not have it is
         one reader who can sign in as every guest. There is no query a guest
         needs to make here: their pass is checked SERVER SIDE by /auth/guest,
         through the admin SDK, which does not consult these rules at all.
       - guestVisits/{id} is a RECORD ABOUT A PERSON, kept so Allen can see who
         looked at the preview and for how long. A guest reading it would be
         reading their own surveillance, and reading each other's.

       SO NO GUEST WRITE IS ADDED ANYWHERE IN THIS FILE, and "a viewer writes
       nothing" stays literally true: every row in both collections is written by
       the server with admin credentials, which bypass rules entirely. The owner
       write grant here is for the console snippets the owner tools emit, which is
       how a pass is created and revoked.
       ===================================================================== */
    match /guestPasses/{passId} {
      allow read, write: if owner();
    }
    match /guestVisits/{visitId} {
      allow read, write: if owner();
    }

  }
}
